{
  "private": true,
  "packageManager": "npm@11.12.1",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ && stylelint 'src/**/*.{css,svelte}' 'public/*.css'",
    "lint:css": "stylelint 'src/**/*.{css,svelte}' 'public/*.css'",
    "lint:fix": "eslint src/ --fix && stylelint --fix 'src/**/*.{css,svelte}' 'public/*.css'",
    "check": "npx svelte-check",
    "full": "npm ci && npx svelte-check && npm run lint && npm run build && cd ../.. && golangci-lint run ./... && go run ./cmd/web --http-addr '0.0.0.0:8081'"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^25.9.1",
    "csstype": "^3.2.3",
    "eslint": "^10.4.1",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "svelte": "^5.55.10",
    "svelte-check": "^4.4.8",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "bits-ui": "^2.18.1",
    "svelte-sonner": "^1.1.1"
  }
}
