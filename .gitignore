#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary and setup files
*.test
.docker-build-integration/

# Code coverage profiles and other test artifacts
*.out
coverage.*
coverage.html
*.coverprofile
profile.cov

# Dependency directories
vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Node.js
node_modules/
/package-lock.json

# Build output
/web/static/
/internal/web/static/
/web/ui/dist/

# Built binaries
blt-volume-manager
blt-volume-manager-web
blt-volume-manager-plugin
.node-bin

# Nix build result symlinks
result
result-*
flake.nix.tmp

# Editor/IDE
.idea/
.vscode/
.vscode/gitcharm-changelists.json
